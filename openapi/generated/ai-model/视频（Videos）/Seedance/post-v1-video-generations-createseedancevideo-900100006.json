{
  "openapi": "3.1.0",
  "info": {
    "title": "Seedance 视频生成",
    "version": "1.0.0",
    "description": "豆包 Seedance 视频生成接口。该接口走异步视频任务流程，提交后返回任务 ID，再通过查询接口获取状态和结果。常用参数为 `model`、`prompt`、`seconds`、`size`，需要比例、清晰度或音频时放入 `metadata`。"
  },
  "tags": [
    {
      "name": "视频（Videos）/Seedance"
    }
  ],
  "x-codeSamples": [
    {
      "lang": "bash",
      "label": "cURL",
      "source": "curl \"$BASE_URL/v1/video/generations\" \\\n  -H \"Authorization: Bearer $NODEKEY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"model\": \"doubao-seedance-2-0-260128\",\n    \"prompt\": \"手持镜头穿过清晨的咖啡店，阳光从窗边扫过桌面\",\n    \"seconds\": \"5\",\n    \"size\": \"1280x720\",\n    \"metadata\": {\n      \"ratio\": \"16:9\",\n      \"resolution\": \"720p\",\n      \"generate_audio\": false\n    }\n  }'"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/video/generations": {
      "post": {
        "tags": [
          "视频（Videos）/Seedance"
        ],
        "summary": "Seedance 视频生成",
        "description": "豆包 Seedance 视频生成接口。该接口走异步视频任务流程，提交后返回任务 ID，再通过查询接口获取状态和结果。常用参数为 `model`、`prompt`、`seconds`、`size`，需要比例、清晰度或音频时放入 `metadata`。",
        "operationId": "createseedancevideo",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "doubao-seedance-1-0-pro-250528",
                      "doubao-seedance-1-0-lite-t2v",
                      "doubao-seedance-1-0-lite-i2v",
                      "doubao-seedance-1-5-pro-251215",
                      "doubao-seedance-2-0-260128",
                      "doubao-seedance-2-0-fast-260128"
                    ],
                    "description": "Seedance 模型名称。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "视频生成提示词。项目会把该字段追加为上游 `content` 中的 text 项。"
                  },
                  "image": {
                    "type": "string",
                    "description": "单张图生视频参考图 URL。项目会转换为上游 `content[].image_url.url`。"
                  },
                  "images": {
                    "type": "array",
                    "description": "多张图生视频参考图 URL。项目会逐项转换为上游 `content[].image_url.url`。",
                    "items": {
                      "type": "string"
                    }
                  },
                  "seconds": {
                    "type": "string",
                    "description": "视频时长，字符串格式；项目会转换为上游 `duration`。"
                  },
                  "duration": {
                    "type": "integer",
                    "description": "兼容字段，整数秒。豆包 Seedance 上游请求建议使用 `seconds`，或通过 `metadata.duration` 透传。"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Seedance 上游扩展参数。适配器会将该对象合并进豆包任务请求。",
                    "properties": {
                      "content": {
                        "type": "array",
                        "description": "上游多模态内容数组。项目会移除其中已有的 text 项，并把顶层 `prompt` 作为最终 text 项追加。",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "text",
                                "image_url",
                                "video_url",
                                "audio_url"
                              ]
                            },
                            "text": {
                              "type": "string"
                            },
                            "image_url": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ]
                            },
                            "video_url": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ]
                            },
                            "audio_url": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ]
                            },
                            "role": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "x-apifox-orders": [
                            "type",
                            "text",
                            "image_url",
                            "video_url",
                            "audio_url",
                            "role"
                          ]
                        }
                      },
                      "resolution": {
                        "type": "string",
                        "description": "输出分辨率，例如 `720p`、`1080p`。"
                      },
                      "ratio": {
                        "type": "string",
                        "description": "视频比例，例如 `16:9`、`9:16`、`1:1`、`4:3`、`3:4`。"
                      },
                      "duration": {
                        "type": "integer",
                        "description": "视频时长。"
                      },
                      "frames": {
                        "type": "integer",
                        "description": "帧数。"
                      },
                      "seed": {
                        "type": "integer",
                        "description": "随机种子。"
                      },
                      "camera_fixed": {
                        "type": "boolean",
                        "description": "是否固定镜头。"
                      },
                      "watermark": {
                        "type": "boolean",
                        "description": "是否添加水印。"
                      },
                      "generate_audio": {
                        "type": "boolean",
                        "description": "是否生成音频。"
                      },
                      "return_last_frame": {
                        "type": "boolean",
                        "description": "是否返回最后一帧。"
                      },
                      "service_tier": {
                        "type": "string",
                        "description": "服务档位。"
                      },
                      "callback_url": {
                        "type": "string",
                        "description": "上游回调地址。"
                      },
                      "tools": {
                        "type": "array",
                        "description": "工具配置，例如 web search。",
                        "items": {
                          "type": "object",
                          "properties": {
                            "type": {
                              "type": "string"
                            }
                          },
                          "x-apifox-orders": [
                            "type"
                          ]
                        }
                      }
                    },
                    "x-apifox-orders": [
                      "content",
                      "resolution",
                      "ratio",
                      "duration",
                      "frames",
                      "seed",
                      "camera_fixed",
                      "watermark",
                      "generate_audio",
                      "return_last_frame",
                      "service_tier",
                      "callback_url",
                      "tools"
                    ]
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "image",
                  "images",
                  "seconds",
                  "duration",
                  "metadata"
                ],
                "example": {
                  "model": "doubao-seedance-2-0-260128",
                  "prompt": "手持镜头穿过清晨的咖啡店，阳光从窗边扫过桌面",
                  "seconds": "5",
                  "size": "1280x720",
                  "metadata": {
                    "ratio": "16:9",
                    "resolution": "720p",
                    "generate_audio": false
                  }
                }
              },
              "example": {
                "model": "doubao-seedance-2-0-260128",
                "prompt": "手持镜头穿过清晨的咖啡店，阳光从窗边扫过桌面",
                "seconds": "5",
                "size": "1280x720",
                "metadata": {
                  "ratio": "16:9",
                  "resolution": "720p",
                  "generate_audio": false
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功创建视频生成任务。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "公开任务 ID。"
                    },
                    "task_id": {
                      "type": "string",
                      "description": "兼容字段，公开任务 ID。"
                    },
                    "object": {
                      "type": "string",
                      "description": "对象类型，通常为 `video`。"
                    },
                    "model": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "in_progress",
                        "completed",
                        "failed",
                        "unknown"
                      ]
                    },
                    "progress": {
                      "type": "integer"
                    },
                    "created_at": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "object",
                    "model",
                    "status",
                    "progress",
                    "created_at"
                  ],
                  "x-apifox-orders": [
                    "id",
                    "task_id",
                    "object",
                    "model",
                    "status",
                    "progress",
                    "created_at"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}