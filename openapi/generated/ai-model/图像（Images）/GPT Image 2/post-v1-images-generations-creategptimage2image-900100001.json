{
  "openapi": "3.1.0",
  "info": {
    "title": "GPT Image 2 图像生成",
    "version": "1.0.0",
    "description": "使用 OpenAI 图片接口生成图像。当前项目支持 `gpt-image-2-1k`、`gpt-image-2-2k`、`gpt-image-2-4k` 三个模型变体；未传 `quality` 时默认使用 `medium`，未传 `n` 或传 `0` 时按 `1` 处理。"
  },
  "tags": [
    {
      "name": "图像（Images）/GPT Image 2"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/images/generations": {
      "post": {
        "tags": [
          "图像（Images）/GPT Image 2"
        ],
        "summary": "GPT Image 2 图像生成",
        "description": "使用 OpenAI 图片接口生成图像。当前项目支持 `gpt-image-2-1k`、`gpt-image-2-2k`、`gpt-image-2-4k` 三个模型变体；未传 `quality` 时默认使用 `medium`，未传 `n` 或传 `0` 时按 `1` 处理。",
        "operationId": "creategptimage2image",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "gpt-image-2-1k",
                      "gpt-image-2-2k",
                      "gpt-image-2-4k"
                    ],
                    "description": "模型名称。`gpt-image-2-1k` 默认生成 `1024x1024`；`gpt-image-2-2k` 默认生成 `2048x2048`；`gpt-image-2-4k` 默认生成 `3840x2160`。"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "图像提示词。"
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "生成图片数量。未传或传 `0` 时按 `1` 处理。"
                  },
                  "size": {
                    "type": "string",
                    "description": "输出尺寸。`gpt-image-2-1k` 支持 `1024x1024`、`1536x1024`、`1024x1536`；`gpt-image-2-2k` 支持 `2048x2048`、`2048x1152`；`gpt-image-2-4k` 支持 `3840x2160`、`2160x3840`。"
                  },
                  "quality": {
                    "type": "string",
                    "default": "medium",
                    "description": "生成质量。项目未传时默认补为 `medium`。"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "url",
                      "b64_json"
                    ],
                    "description": "返回图片格式。"
                  },
                  "background": {
                    "type": "string",
                    "description": "透传给上游的背景设置。"
                  },
                  "moderation": {
                    "type": "string",
                    "description": "透传给上游的内容审核设置。"
                  },
                  "output_format": {
                    "type": "string",
                    "description": "透传给上游的输出格式。"
                  },
                  "output_compression": {
                    "type": "integer",
                    "description": "透传给上游的输出压缩参数。"
                  },
                  "partial_images": {
                    "description": "透传给上游的局部图片参数。"
                  },
                  "user": {
                    "type": "string",
                    "description": "最终用户标识。"
                  }
                },
                "required": [
                  "model",
                  "prompt"
                ],
                "x-apifox-orders": [
                  "model",
                  "prompt",
                  "n",
                  "size",
                  "quality",
                  "response_format",
                  "background",
                  "moderation",
                  "output_format",
                  "output_compression",
                  "partial_images",
                  "user"
                ]
              }
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "created": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "b64_json": {
                            "type": "string"
                          },
                          "revised_prompt": {
                            "type": "string"
                          }
                        },
                        "x-apifox-orders": [
                          "url",
                          "b64_json",
                          "revised_prompt"
                        ]
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": {
                          "type": "integer"
                        },
                        "completion_tokens": {
                          "type": "integer"
                        },
                        "total_tokens": {
                          "type": "integer"
                        },
                        "input_tokens": {
                          "type": "integer"
                        },
                        "output_tokens": {
                          "type": "integer"
                        },
                        "prompt_tokens_details": {
                          "type": "object",
                          "properties": {
                            "text_tokens": {
                              "type": "integer"
                            },
                            "image_tokens": {
                              "type": "integer"
                            },
                            "cached_tokens": {
                              "type": "integer"
                            }
                          }
                        },
                        "completion_tokens_details": {
                          "type": "object",
                          "properties": {
                            "image_tokens": {
                              "type": "integer"
                            },
                            "text_tokens": {
                              "type": "integer"
                            }
                          }
                        }
                      },
                      "x-apifox-orders": [
                        "prompt_tokens",
                        "completion_tokens",
                        "total_tokens",
                        "input_tokens",
                        "output_tokens",
                        "prompt_tokens_details",
                        "completion_tokens_details"
                      ]
                    }
                  },
                  "required": [
                    "created",
                    "data"
                  ],
                  "x-apifox-orders": [
                    "created",
                    "data",
                    "usage"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}